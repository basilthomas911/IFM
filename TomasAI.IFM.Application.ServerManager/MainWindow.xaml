<Window x:Class="TomasAI.IFM.Application.ServerManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TomasAI.IFM.Application.ServerManager"
        mc:Ignorable="d"
        Title="IFM Server Manager" Height="600" Width="1100" WindowStyle="ToolWindow"
        Visibility="{Binding ConsoleVisibility}" 
        WindowState="{Binding ConsoleWindowState}">
    <Grid>
        <TabControl>
            <TabItem Header="Applications">
                <DataGrid ItemsSource="{Binding Applications}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Application" Width="180" Binding="{Binding DisplayName}"/>
                        <DataGridCheckBoxColumn Header="Enabled" Width="80" Binding="{Binding Enabled}"/>
                        <DataGridTextColumn Header="Start order" Width="90" Binding="{Binding StartOrder}"/>
                        <DataGridTextColumn Header="Executable" Width="*" Binding="{Binding ExecutablePath}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Scheduled Tasks">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="8">
                        <Button Content="Refresh" Command="{Binding RefreshSchedulerCommand}" Padding="14,4"/>
                        <Button Content="New" Command="{Binding NewScheduleCommand}" Margin="6,0,0,0" Padding="14,4"/>
                        <Button Content="Enable/Disable" Command="{Binding ToggleScheduleCommand}" Margin="6,0,0,0" Padding="10,4"/>
                        <Button Content="Run now" Command="{Binding RunNowCommand}" Margin="6,0,0,0" Padding="10,4"/>
                        <Button Content="Delete" Command="{Binding DeleteScheduleCommand}" Margin="6,0,0,0" Padding="10,4"/>
                        <TextBlock Margin="12,5,0,0" Text="{Binding SchedulerOperationMessage}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Schedules}" SelectedItem="{Binding SelectedSchedule}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Enabled" Width="70" Binding="{Binding Enabled}"/>
                            <DataGridTextColumn Header="Name" Width="180" Binding="{Binding Name}"/>
                            <DataGridTextColumn Header="Task" Width="170" Binding="{Binding TaskKey}"/>
                            <DataGridTextColumn Header="Schedule" Width="*" Binding="{Binding ScheduleExplanation}"/>
                            <DataGridTextColumn Header="Timezone" Width="140" Binding="{Binding TimeZoneId}"/>
                            <DataGridTextColumn Header="Next UTC" Width="170" Binding="{Binding NextFireUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"/>
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,4" Text="Name"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Margin="6,2" Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Margin="12,4,0,4" Text="Approved task"/>
                            <ComboBox Grid.Row="0" Grid.Column="3" Margin="6,2" ItemsSource="{Binding TaskCatalog}" DisplayMemberPath="DisplayName" SelectedValuePath="TaskKey" SelectedValue="{Binding EditorTaskKey}"/>
                            <TextBox Grid.Row="0" Grid.Column="4" Margin="6,2" Text="{Binding EditorDescription, UpdateSourceTrigger=PropertyChanged}" ToolTip="Description"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4" Text="Kind"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" Margin="6,2" ItemsSource="{Binding ScheduleKinds}" SelectedItem="{Binding EditorKind}"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Margin="12,4,0,4" Text="Expression"/>
                            <TextBox Grid.Row="1" Grid.Column="3" Margin="6,2" Text="{Binding EditorExpression, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Grid.Row="1" Grid.Column="4" Margin="6,2" Text="{Binding EditorTimeZoneId, UpdateSourceTrigger=PropertyChanged}" ToolTip="Timezone ID"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,4" Text="Misfire"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" Margin="6,2" ItemsSource="{Binding MisfirePolicies}" SelectedItem="{Binding EditorMisfirePolicy}"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Margin="12,4,0,4" Text="Max runtime (s)"/>
                            <TextBox Grid.Row="2" Grid.Column="3" Margin="6,2" Text="{Binding EditorMaximumRuntimeSeconds}"/>
                            <StackPanel Grid.Row="2" Grid.Column="4" Orientation="Horizontal">
                                <TextBlock Margin="6,4" Text="Retention success/failure days"/>
                                <TextBox Width="45" Margin="3,2" Text="{Binding EditorSuccessfulRetentionDays}"/>
                                <TextBox Width="45" Margin="3,2" Text="{Binding EditorFailedRetentionDays}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,4" Text="Reason"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="6,2" Text="{Binding OperatorReason, UpdateSourceTrigger=PropertyChanged}" ToolTip="Required for enable, disable, run, cancel, retry, and delete"/>
                            <StackPanel Grid.Row="3" Grid.Column="4" Orientation="Horizontal">
                                <Button Content="Validate / Preview" Command="{Binding ValidateScheduleCommand}" Margin="6,2" Padding="10,4"/>
                                <Button Content="Save disabled / Update" Command="{Binding SaveScheduleCommand}" Margin="6,2" Padding="10,4"/>
                            </StackPanel>

                            <ItemsControl Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5" ItemsSource="{Binding SchedulePreview}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Utc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss zzz} UTC}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="Task Runs">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="8">
                        <Button Content="Cancel" Command="{Binding CancelRunCommand}" Padding="10,4"/>
                        <Button Content="Retry" Command="{Binding RetryRunCommand}" Margin="6,0" Padding="10,4"/>
                        <ComboBox Width="140" ItemsSource="{Binding OutputStreams}" SelectedItem="{Binding SelectedOutputStream}"/>
                        <Button Content="Load output" Command="{Binding LoadOutputCommand}" Margin="6,0" Padding="10,4"/>
                        <TextBlock Margin="10,5" Text="{Binding SchedulerOperationMessage}"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding TaskRuns}" SelectedItem="{Binding SelectedTaskRun}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Run" Width="220" Binding="{Binding RunId}"/>
                            <DataGridTextColumn Header="Task" Width="170" Binding="{Binding TaskKey}"/>
                            <DataGridTextColumn Header="State" Width="110" Binding="{Binding State}"/>
                            <DataGridTextColumn Header="Origin" Width="100" Binding="{Binding Origin}"/>
                            <DataGridTextColumn Header="Started UTC" Width="170" Binding="{Binding StartedAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/>
                            <DataGridTextColumn Header="Exit" Width="65" Binding="{Binding ExitCode}"/>
                            <DataGridTextColumn Header="Detail" Width="*" Binding="{Binding Detail}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding TaskOutput}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Width="70" Binding="{Binding Sequence}"/>
                            <DataGridTextColumn Header="Output" Width="*" Binding="{Binding Text}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Logs">
                <DataGrid Name="ConsoleStatusDataGrid"
                          ItemsSource="{Binding ConsoleStatus}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          EnableRowVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Width="165" Binding="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss.fff}}"/>
                        <DataGridTextColumn Header="Process" Width="150" Binding="{Binding ProcessName}"/>
                        <DataGridTextColumn Header="Stream" Width="120" Binding="{Binding Stream}"/>
                        <DataGridTextColumn Header="Message" Width="*" Binding="{Binding Message}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Scheduler Health">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Refresh" Command="{Binding RefreshSchedulerCommand}" Padding="14,4"/>
                            <TextBlock Margin="12,5,0,0" FontWeight="Bold" Text="{Binding SchedulerState}"/>
                            <TextBlock Margin="8,5,0,0" Text="{Binding SchedulerMessage}"/>
                        </StackPanel>
                        <WrapPanel Margin="0,10,0,6">
                            <TextBlock Margin="0,0,18,0" Text="{Binding SchedulerVersion, StringFormat=Version: {0}}"/>
                            <TextBlock Margin="0,0,18,0" Text="{Binding SchedulerDatabaseAvailable, StringFormat=PostgreSQL: {0}}"/>
                            <TextBlock Margin="0,0,18,0" Text="{Binding QuartzAvailable, StringFormat=Quartz: {0}}"/>
                            <TextBlock Margin="0,0,18,0" Text="{Binding SchedulingStarted, StringFormat=Scheduling: {0}}"/>
                            <TextBlock Text="{Binding SchedulerLastRefreshedUtc, StringFormat=Refreshed UTC: {0:yyyy-MM-dd HH:mm:ss}}"/>
                        </WrapPanel>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Margin="0,8,0,5" FontWeight="Bold" Text="Approved task catalog"/>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding TaskCatalog}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Task" Width="180" Binding="{Binding DisplayName}"/>
                            <DataGridTextColumn Header="Environment" Width="110" Binding="{Binding RequiredEnvironment}"/>
                            <DataGridTextColumn Header="Risk" Width="130" Binding="{Binding RiskClassification}"/>
                            <DataGridCheckBoxColumn Header="Deployed" Width="80" Binding="{Binding ExecutableAvailable}"/>
                            <DataGridTextColumn Header="Manifest" Width="80" Binding="{Binding ManifestVersion}"/>
                            <DataGridTextColumn Header="Executable" Width="*" Binding="{Binding ExecutablePath}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
