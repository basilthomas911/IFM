<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <DatabentoNativeImplementation Condition="'$(DatabentoNativeImplementation)' == ''">Cpp</DatabentoNativeImplementation>
    <DatabentoEnableLive Condition="'$(DatabentoEnableLive)' == '' and Exists('..\native\DatabentoFeed.Native\out\live-build\$(Configuration)\databento_feed_native.dll')">true</DatabentoEnableLive>
    <DatabentoNativeBuildKind Condition="'$(DatabentoEnableLive)' == 'true'">live-build</DatabentoNativeBuildKind>
    <DatabentoNativeBuildKind Condition="'$(DatabentoNativeBuildKind)' == ''">build</DatabentoNativeBuildKind>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Docs\" />
    <InternalsVisibleTo Include="TomasAI.IFM.Domain.MarketData.Feed.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TomasAI.IFM.Framework.MarketData\TomasAI.IFM.Framework.MarketData.csproj" />
    <ProjectReference Include="..\TomasAI.IFM.Domain.MarketData.Feed.Shared\TomasAI.IFM.Domain.MarketData.Feed.Shared.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(DatabentoNativeImplementation)' == 'Cpp' and Exists('..\native\DatabentoFeed.Native\out\$(DatabentoNativeBuildKind)\$(Configuration)\databento_feed_native.dll')">
    <None Include="..\native\DatabentoFeed.Native\out\$(DatabentoNativeBuildKind)\$(Configuration)\*.dll"
          Link="runtimes\win-x64\native\%(Filename)%(Extension)"
          CopyToOutputDirectory="Always"
          CopyToPublishDirectory="Always" />
  </ItemGroup>

  <ItemGroup Condition="'$(DatabentoNativeImplementation)' == 'Rust' and Exists('..\native.rust\DatabentoFeed.Rust\out\$(DatabentoNativeBuildKind)\$(Configuration)\databento_feed_native.dll')">
    <None Include="..\native.rust\DatabentoFeed.Rust\out\$(DatabentoNativeBuildKind)\$(Configuration)\*.dll"
          Link="runtimes\win-x64\native\%(Filename)%(Extension)"
          CopyToOutputDirectory="Always"
          CopyToPublishDirectory="Always" />
  </ItemGroup>

</Project>
