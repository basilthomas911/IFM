<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <!-- Development builds use the independently parity-tested Rust ABI so a normal
         managed rebuild cannot package a stale C++ DLL after the native contract changes. -->
    <DatabentoNativeImplementation Condition="'$(DatabentoNativeImplementation)' == '' and '$(Configuration)' == 'Debug'">Rust</DatabentoNativeImplementation>
    <DatabentoNativeImplementation Condition="'$(DatabentoNativeImplementation)' == ''">Cpp</DatabentoNativeImplementation>
    <!-- Debug CRT binaries are not redistributable and are absent on normal developer/runtime hosts. -->
    <DatabentoNativeConfiguration Condition="'$(DatabentoNativeConfiguration)' == ''">Release</DatabentoNativeConfiguration>
    <DatabentoEnableLive Condition="'$(DatabentoEnableLive)' == '' and Exists('..\native\DatabentoFeed.Native\out\live-build\$(DatabentoNativeConfiguration)\databento_feed_native.dll')">true</DatabentoEnableLive>
    <DatabentoNativeBuildKind Condition="'$(DatabentoEnableLive)' == 'true'">live-build</DatabentoNativeBuildKind>
    <DatabentoNativeBuildKind Condition="'$(DatabentoNativeBuildKind)' == ''">build</DatabentoNativeBuildKind>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Docs\" />
    <InternalsVisibleTo Include="TomasAI.IFM.Domain.MarketData.Feed.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TomasAI.IFM.Framework.MarketData\TomasAI.IFM.Framework.MarketData.csproj" />
    <ProjectReference Include="..\TomasAI.IFM.Domain.MarketData.Feed.Shared\TomasAI.IFM.Domain.MarketData.Feed.Shared.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(DatabentoNativeImplementation)' == 'Cpp' and Exists('..\native\DatabentoFeed.Native\out\$(DatabentoNativeBuildKind)\$(DatabentoNativeConfiguration)\databento_feed_native.dll')">
    <None Include="..\native\DatabentoFeed.Native\out\$(DatabentoNativeBuildKind)\$(DatabentoNativeConfiguration)\*.dll"
          Link="runtimes\win-x64\native\%(Filename)%(Extension)"
          CopyToOutputDirectory="Always"
          CopyToPublishDirectory="Always" />
  </ItemGroup>

  <ItemGroup Condition="'$(DatabentoNativeImplementation)' == 'Rust' and Exists('..\native.rust\DatabentoFeed.Rust\out\$(DatabentoNativeBuildKind)\$(DatabentoNativeConfiguration)\databento_feed_native.dll')">
    <None Include="..\native.rust\DatabentoFeed.Rust\out\$(DatabentoNativeBuildKind)\$(DatabentoNativeConfiguration)\*.dll"
          Link="runtimes\win-x64\native\%(Filename)%(Extension)"
          CopyToOutputDirectory="Always"
          CopyToPublishDirectory="Always" />
  </ItemGroup>

</Project>
