  "implementation": [
    {
      "area": "Publication reuse",
      "change": "Generation-cached managed snapshots and MessagePack buffers; confirmation/submission overlays invalidate separately."
    },
    {
      "area": "Publication sections",
      "change": "Quote refreshes reuse fund/order workspace, expiry choices and execution evidence; ABI v4 remains unchanged."
    },
    {
      "area": "Typed serialization",
      "change": "Generated market-chain and selected-leg display DTOs; direct high-volume envelope formatter; editor fallback remains."
    },
    {
      "area": "Display coalescing",
      "change": "Sidebar display invalidations coalesce at 40 ms; source console events and trading acknowledgements are retained."
    },
    {
      "area": "Temporary collections",
      "change": "Stream document encoding without Project trees; cache stable expiries, evidence and submission contexts."
    },
    {
      "area": "Session execution",
      "change": "Bounded single-consumer asynchronous owners replace per-operation Task.Run in all three editor gateways."
    },
    {
      "area": "Lock scope",
      "change": "Gateway snapshot locks rebuild only on generation changes; sidebar projection/encoding runs outside its state lock."
    },
    {
      "area": "Buffers",
      "change": "Dedicated bounded ArrayPool for transient encoding; exact owned output arrays never returned to the pool."
    },
    {
      "area": "Retention and shutdown",
      "change": "Bound read-only inspection/lookup outcome histories; retain mutation deduplication; drain owners before model disposal."
    },
    {
      "area": "GC selection",
      "change": "Explicit workstation/background GC. Both modes benchmarked; no application GC.Collect calls."
    }
  ],
