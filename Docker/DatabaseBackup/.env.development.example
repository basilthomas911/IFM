# Copy to Docker/DatabaseBackup/.env for local use; never commit the populated file.
IFM_BACKUP_ROOT=E:/IFM/DatabaseBackup
IFM_NATS_URL=nats://host.docker.internal:4222
IFM_BACKUP_HOST_ID=development-database-backup-host
IFM_ENVIRONMENT=development
IFM_BACKUP_ENABLED=true
IFM_BACKUP_DRY_RUN=false
IFM_POSTGRES_BACKUP_ENABLED=true
IFM_SCYLLA_BACKUP_ENABLED=false
IFM_BACKUP_CONSUMER_PREFIX=ifm-database-backup-development
IFM_BACKUP_DELIVER_POLICY=1
IFM_BACKUP_HEALTH_PORT=8088
IFM_SCYLLA_MANAGER_API_URL=http://host.docker.internal:5080/api/v1

# Required when PostgreSQL native backup is enabled. Replace every placeholder locally.
IFM_POSTGRES_BACKUP_CONNECTION=Host=host.docker.internal;Port=5432;Database=postgres;Username=<development-user>;Password=<development-password>;SSL Mode=Disable;Pooling=false
