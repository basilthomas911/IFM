<Project>
 <PropertyGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('IntegrationTests')) Or $([System.String]::Copy('$(MSBuildProjectName)').EndsWith('IntegratedTests'))">
   <!-- Integration hosts use shared process-wide infrastructure and must not run
        multiple test collections concurrently. -->
   <IFMSerialIntegrationTests>true</IFMSerialIntegrationTests>
   <TestTfmsInParallel>false</TestTfmsInParallel>
   <RunSettingsFilePath>$(MSBuildThisFileDirectory)integration.runsettings</RunSettingsFilePath>
 </PropertyGroup>

 <PropertyGroup>
   <NoWarn>$(NoWarn);CS8618;MsgPack017;CS8604;CS8603;CS8602;CS8625;CS8601;CS0078;CS8767;NS2002;CS8600;CS9113;CS8629;CS0108;NS5003;xUnit1013;SYSLIB0051;CS0219;CS8765;CS8714;CS8766;CS0168;CS4014;CS7022;CS8634;CS8631;NS5000;xUnit1031;CS0105;CA2264;CS8073;CS8619;CS8632;SYSLIB0006;CS8620</NoWarn>
 </PropertyGroup>
 
 <PropertyGroup>
	<Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
 </PropertyGroup>

 <ItemGroup Condition="'$(IFMSerialIntegrationTests)' == 'true'">
   <Compile Include="$(MSBuildThisFileDirectory)IntegrationTests.AssemblyInfo.cs"
            Link="IntegrationTests.AssemblyInfo.cs" />
   <None Include="$(MSBuildThisFileDirectory)xunit.integration.runner.json"
         Link="xunit.runner.json"
         TargetPath="xunit.runner.json"
         CopyToOutputDirectory="PreserveNewest"
         CopyToPublishDirectory="PreserveNewest" />
 </ItemGroup>

 <ItemGroup Condition="'$(MSBuildProjectName)' == 'TomasAI.IFM.Domain.MarketData.IntegrationTests' Or '$(MSBuildProjectName)' == 'TomasAI.IFM.Domain.MarketData.Analytics.IntegrationTests' Or '$(MSBuildProjectName)' == 'TomasAI.IFM.Domain.MarketData.Feed.IntegrationTests' Or '$(MSBuildProjectName)' == 'TomasAI.IFM.Domain.MarketData.Securities.IntegrationTests' Or '$(MSBuildProjectName)' == 'TomasAI.IFM.Domain.OptionPricer.IntegrationTests' Or '$(MSBuildProjectName)' == 'TomasAI.IFM.Domain.Portfolio.IntegrationTests' Or '$(MSBuildProjectName)' == 'TomasAI.IFM.Domain.Trade.IntegratedTests'">
   <Compile Include="$(MSBuildThisFileDirectory)DomainActorIntegrationInfrastructureFixture.cs"
            Link="DomainActorIntegrationInfrastructureFixture.cs" />
   <AssemblyAttribute Include="Xunit.TestFrameworkAttribute">
     <_Parameter1>DomainActorIntegrationTestFramework</_Parameter1>
     <_Parameter2>$(AssemblyName)</_Parameter2>
   </AssemblyAttribute>
 </ItemGroup>
 
 <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer" Version="2.0.257">
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.16.0.128591">
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Analyzers" Version="4.14.1">
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.analyzers" Version="1.26.0">
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
 </ItemGroup>
</Project>
