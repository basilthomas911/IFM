{
  "EventLogPersistence": {
    "WriteMode": "Sequential",
    "UseLz4Compression": false,
    "QueueCommandCapacity": 8192,
    "MaximumEventsPerBatch": 256,
    "MaximumBatchBytes": 1048576,
    "MaximumOldestRequestDelay": "00:00:00.001",
    "MaximumEventsPerCommand": 4096,
    "MaximumEventPayloadBytes": 16777216,
    "MaximumCommandPayloadBytes": 33554432,
    "ShutdownDrainTimeout": "00:00:10"
  },
  "CommandAuditPersistence": {
    "WriteMode": "WindowedMessagePack",
    "QueueCommandCapacity": 8192,
    "MaximumCommandsPerBatch": 64,
    "MaximumBatchBytes": 262144,
    "MaximumCommandPayloadBytes": 1048576,
    "MaximumOldestRequestDelay": "00:00:00.001",
    "ShutdownDrainTimeout": "00:00:10"
  },
  "InMemoryEventSourceActor": {
    "OptionTradeLegDataEnabled": true,
    "MaximumResidentStreams": 4096,
    "MaximumCommandsPerWindow": 64
  },
  "DeploymentIdentity": {
    "ManifestPath": ""
  },
  "ApplicationStartup": {
    "AutoStartAfterBootstrap": true,
    "BootstrapTimeout": "00:02:00",
    "ParticipantTimeout": "00:02:00",
    "HandoffObservationTimeout": "00:00:10",
    "HandoffRetryDelay": "00:00:01",
    "HandoffMaximumAttempts": 3
  },
  "MarketDataRecovery": {
    "Enabled": true,
    "NativeBackend": "Cpp",
    "PollInterval": "00:00:15",
    "ProbeTimeout": "00:00:01",
    "AttemptTwoDelay": "00:00:05",
    "AttemptThreeDelay": "00:00:15",
    "PersistenceRetryDelay": "00:00:00.100",
    "HardStallTimeout": "00:05:00",
    "DatasetTeardownTimeout": "00:00:10",
    "DatasetQualificationTimeout": "00:00:30",
    "Stage4": {
      "Enabled": false
    },
    "Stage3": {
      "Enabled": false,
      "LiveTradingPollInterval": "00:01:00",
      "LiveTradingEscalationWindow": "00:05:00",
      "LiveTradingMaximumCooperativeAttempts": 5,
      "LiveTradingHealthyQualificationPeriod": "00:01:00",
      "OffTradingPollInterval": "00:05:00",
      "OffTradingStallTimeout": "00:15:00",
      "WorkerHandshakeTimeout": "00:00:10",
      "WorkerStartTimeout": "00:02:30",
      "WorkerCommandTimeout": "00:00:10",
      "WorkerGracefulStopTimeout": "00:00:10",
      "WorkerForceKillTimeout": "00:00:05",
      "WorkerQualificationTimeout": "00:00:30",
      "MaximumProcessReplacementsPerIncident": 3,
      "ProcessReplacementWindow": "00:15:00",
      "ControlFrameMaximumBytes": 4194304
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AppSettings": {
    "Databento": {
      "TradeStrategySymbolDatasets": [ "GLBX.MDP3" ],
      "OptionExpiryCalendar": {
        "Symbols": [ "ES" ],
        "MaximumProviderConcurrency": 2,
        "MaximumVerificationConcurrency": 4,
        "EnableDiagnosticWindowBenchmark": false
      }
    },
    "IntrinsicTimeStrategyWorkflow": {
      "Enabled": true
    },
    "RegimeDiscoveryExecution": {
      "MaximumExecutionDuration": "00:02:00"
    },
    "HistoricalAnalyticsWarmup": {
      "Enabled": true,
      "LookbackCalendarDays": 365,
      "MinimumValidDailySessions": 200,
      "MaximumCostUsd": 10.0,
      "MaximumBytes": 1073741824,
      "NormalizationVersion": "historical-daily-v1",
      "CalculationConfigurationVersion": "ema-bb-daily-v1"
    },
    "Fmp": {
      "Enabled": true,
      "LatestTreasuryLookbackDays": 14,
      "MaximumProviderWindowDays": 90,
      "MaximumRequestRangeDays": 3660,
      "MaximumImportRangeDays": 366,
      "MaximumConcurrentRequests": 2,
      "CountryCodes": [ "US" ],
      "TreasuryDuplicatePolicy": "Overwrite",
      "EconomicCalendarDuplicatePolicy": "Overwrite",
      "Schedule": {
        "Enabled": false,
        "Interval": "06:00:00",
        "LookbackDays": 7,
        "ForwardDays": 7,
        "CountryCodes": [ "US" ]
      }
    }
  },
  "Telemetry": {
    "Metrics": {
      "Enabled": false,
      "ServiceName": "TomasAI.IFM.Application.Api.Server",
      "OtlpEndpoint": "http://localhost:4317",
      "OtlpProtocol": "grpc"
    }
  },
  "Portfolio": {
    "Operations": {
      "Enabled": true,
      "QueriesEnabled": true,
      "MutationsEnabled": true,
      "AuthorizationRequired": true
    }
  },
  "ActorRuntime": {
    "InformationLogging": {
      "SuppressedActorTypes": [ "Event", "Realtime" ],
      "SuppressedRoutes": [
        { "ActorType": "Command", "Name": "FuturesVwapSignalCommand", "Verb": "Update" },
        { "ActorType": "Command", "Name": "FuturesVwapSignalCommand", "Verb": "Recover" },
        { "ActorType": "Command", "Name": "FuturesItiSignalCommand", "Verb": "GenerateFuturesItiSignal" },
        { "ActorType": "Query", "Name": "FuturesEodDataQuery", "Verb": "GetFuturesEodData" },
        { "ActorType": "Query", "Name": "FuturesEodDataQuery", "Verb": "GetVixFuturesEodData" }
      ]
    },
    "Startup": {
      "MaximumConcurrency": 8
    },
    "Admission": {
      "Mode": "Enforce",
      "MailboxImplementation": "Channel",
      "GlobalMessageLimit": 32768,
      "GlobalByteLimit": 536870912,
      "MaximumPayloadBytes": 16777216,
      "DefaultActorTypeMessageLimit": 8192,
      "DefaultActorTypeByteLimit": 134217728,
      "DefaultMailboxMessageLimit": 2048,
      "RetainedIdleMailboxesPerActor": 128,
      "JetStreamNakDelayMilliseconds": 250,
      "OverloadErrorCode": -429
    }
  },
  "StartupOrchestration": {
    "ActorStartupTimeout": "00:02:00",
    "MaximumSchemaInitializationConcurrency": 4
  },
  "EventProjectorReliability": {
    "BoundedRecoveryEnabled": true,
    "FencedExecutionEnabled": true,
    "TransactionalOutboxEnabled": true,
    "BacklogMetricsPollingEnabled": true,
    "RecoveryBatchSize": 256,
    "RecoveryStreamConcurrency": 8,
    "MaximumReplayAttempts": 3,
    "InitialReplayDelay": "00:00:30",
    "ClaimLeaseDuration": "00:02:00",
    "OutboxBatchSize": 256,
    "MaximumOutboxAttempts": 20,
    "OutboxPollingInterval": "00:00:30",
    "OutboxDispatchLeaseDuration": "00:02:00",
    "MetricsPollingInterval": "00:00:05",
    "NonDurableQueueCapacity": 8192
  },
  "Nats": {
    "Consumer": {
      "DispatcherCount": 4,
      "DispatcherCapacity": 4096,
      "SubscriptionCapacity": 0,
      "UseOwnedCommandPayloads": true,
      "UseOwnedQueryPayloads": true,
      "FireAndForgetTraffic": {
        "Command": "RequestReplyOnly",
        "Query": "RequestReplyOnly",
        "Function": "RequestReplyOnly",
        "Notify": "Optional",
        "Realtime": "Optional"
      }
    },
    "JetStreamConsumer": {
      "DispatcherCount": 4,
      "DispatcherCapacity": 4096,
      "MaxAckPending": 0,
      "MaxMessages": 0,
      "ThresholdMessages": 0,
      "UseOwnedEventPayloads": true
    }
  },
  "AllowedHosts": "*"
}
