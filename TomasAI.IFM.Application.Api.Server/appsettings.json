{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AppSettings": {
    "Fmp": {
      "Enabled": true,
      "LatestTreasuryLookbackDays": 14,
      "MaximumProviderWindowDays": 90,
      "MaximumRequestRangeDays": 3660,
      "MaximumImportRangeDays": 366,
      "MaximumConcurrentRequests": 2,
      "CompatibilityTreasuryLookbackDays": 14,
      "CompatibilityCalendarLookbackDays": 7,
      "CompatibilityCalendarForwardDays": 7,
      "CountryCodes": [ "US" ],
      "TreasuryDuplicatePolicy": "Overwrite",
      "EconomicCalendarDuplicatePolicy": "Overwrite",
      "Schedule": {
        "Enabled": false,
        "Interval": "06:00:00",
        "LookbackDays": 7,
        "ForwardDays": 7,
        "CountryCodes": [ "US" ]
      }
    }
  },
  "Telemetry": {
    "Metrics": {
      "Enabled": false,
      "ServiceName": "TomasAI.IFM.Application.Api.Server",
      "OtlpEndpoint": "http://localhost:4317",
      "OtlpProtocol": "grpc"
    }
  },
  "ActorRuntime": {
    "Admission": {
      "Mode": "ObserveOnly",
      "MailboxImplementation": "Channel",
      "GlobalMessageLimit": 0,
      "GlobalByteLimit": 0,
      "MaximumPayloadBytes": 0,
      "DefaultActorTypeMessageLimit": 0,
      "DefaultActorTypeByteLimit": 0,
      "DefaultMailboxMessageLimit": 8192,
      "RetainedIdleMailboxesPerActor": 1024,
      "JetStreamNakDelayMilliseconds": 250,
      "OverloadErrorCode": -429
    }
  },
  "EventProjectorReliability": {
    "BoundedRecoveryEnabled": true,
    "FencedExecutionEnabled": true,
    "TransactionalOutboxEnabled": true,
    "BacklogMetricsPollingEnabled": true,
    "RecoveryBatchSize": 256,
    "RecoveryStreamConcurrency": 8,
    "MaximumReplayAttempts": 3,
    "InitialReplayDelay": "00:00:30",
    "ClaimLeaseDuration": "00:02:00",
    "OutboxBatchSize": 256,
    "MaximumOutboxAttempts": 20,
    "OutboxPollingInterval": "00:00:00.250",
    "OutboxDispatchLeaseDuration": "00:02:00",
    "MetricsPollingInterval": "00:00:05",
    "NonDurableQueueCapacity": 8192
  },
  "Nats": {
    "Consumer": {
      "DispatcherCount": 4,
      "DispatcherCapacity": 4096,
      "SubscriptionCapacity": 0,
      "UseOwnedCommandPayloads": true,
      "UseOwnedQueryPayloads": true,
      "FireAndForgetTraffic": {
        "Command": "RequestReplyOnly",
        "Query": "RequestReplyOnly",
        "Notify": "Optional",
        "Realtime": "Optional"
      }
    },
    "JetStreamConsumer": {
      "DispatcherCount": 4,
      "DispatcherCapacity": 4096,
      "MaxAckPending": 0,
      "MaxMessages": 0,
      "ThresholdMessages": 0,
      "UseOwnedEventPayloads": true
    }
  },
  "AllowedHosts": "*"
}
