    "SequenceIdDbConnection": "Host=localhost;Port=5432;Database=sequence-id-test-db",
    "TradeDbConnection": "Contact Points=localhost;Port=9042;Default Keyspace=trade_test_db",
    "FundDbConnection": "Contact Points=localhost;Port=9042;Default Keyspace=fund_test_db",
    "ReferenceDbConnection": "Contact Points=localhost;Port=9042;Default Keyspace=reference_test_db",
    "OptionPricerDbConnection": "Contact Points=localhost;Port=9042;Default Keyspace=option_pricer_test_db",
