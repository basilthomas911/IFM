{
  "Telemetry": {
    "Logs": {
      "Enabled": true,
      "ServiceName": "TomasAI.IFM.Application.Api.Server",
      "OtlpEndpoint": "http://localhost:4318/v1/logs",
      "OtlpProtocol": "http/protobuf"
    },
    "Metrics": {
      "Enabled": true,
      "ServiceName": "TomasAI.IFM.Application.Api.Server",
      "OtlpEndpoint": "http://localhost:4317",
      "OtlpProtocol": "grpc"
    },
    "Traces": {
      "Enabled": false
    }
  },
  "MarketData": {
    "FuturesEodAsyncTradeWorker": true,
    "FuturesEodMinuteBatchWriter": true
  },
  "Supervisor": {
    "AutomaticMutationEnabled": true,
    "AllowedOperators": [
      "IFM.UI.Development"
    ]
  },
  "ParameterSets": {
    "SingleUserDevelopmentEnabled": true,
    "RsiHistoricalPilotEnabled": true
  },
  "MarketDataRecovery": {
    "DevelopmentVerification": { "Enabled": true },
    "NativeBackend": "Rust",
    "HardRecovery": {
      "Pipeline": {
        "Enabled": true,
        "OverallTimeout": "00:07:00",
        "SupervisorTimeout": "00:00:30",
        "DownstreamTimeout": "00:00:45"
      },
      "Episode": {
        "EpisodeTimeout": "00:06:00",
        "MaximumContributingReasons": 16
      },
      "Attempts": {
        "OverallTimeout": "00:05:00",
        "AttemptTwoDelay": "00:00:05",
        "AttemptThreeDelay": "00:00:15"
      },
      "Runtime": {
        "MaximumManifestAge": "00:06:00",
        "ContainmentTimeout": "00:00:20",
        "QualificationTimeout": "00:01:00",
        "MaximumInputAge": "00:00:10"
      },
      "CandidateProof": {
        "HoldingCapacityPerDataset": 2048,
        "ProofTimeout": "00:00:30",
        "DrainTimeout": "00:00:05"
      },
      "SoftGate": {
        "ProbeTimeout": "00:00:05",
        "OverallTimeout": "00:00:30",
        "RetryDelay": "00:00:02",
        "MaximumRounds": 3
      },
      "FatalShutdown": {
        "GracefulTimeout": "00:00:30",
        "TelemetryTimeout": "00:00:02",
        "ExitCode": 42
      }
    },
    "Stage3": {
      "Enabled": true,
      "AllowDevelopmentLiveQualification": true,
      "DevelopmentWorkerAssemblyPath": "../../../../TomasAI.IFM.Application.MarketData.Host.Worker/bin/Debug/net10.0/TomasAI.IFM.Application.MarketData.Host.Worker.dll"
    },
    "LivePipeline": {
      "HardResetDelay": "00:05:00",
      "RecoveryObservationWindow": "00:05:00",
      "ForceOneHardResetAfterStartup": false
    }
  },
  "ApplicationStartup": {
    "AutoStartAfterBootstrap": true,
    "BootstrapTimeout": "00:02:00",
    "ParticipantTimeout": "00:02:00",
    "HandoffObservationTimeout": "00:00:10",
    "HandoffRetryDelay": "00:00:01",
    "HandoffMaximumAttempts": 3
  },
  "EventProjectorReliability": {
    "BacklogMetricsPollingEnabled": false
  },
  "Kestrel": {
    "EndPoints": {
      "Http": {
        "Url": "http://localhost:22543"
      }
    }
  },
  "AppSettings": {
    "TelemetryServerBaseUri": "http://localhost:22543/Log/LogEvents",
    "RedisUri": "localhost:6379",
    "StrategyOptionChainCache": {
      "ProvisionDevelopmentDefaults": true
    },
    "IntrinsicTimeStrategyWorkflow": {
      "MarketConditionAssessmentProfileId": "ES.Standard",
      "ProvisionDevelopmentMarketConditionAssessmentDefaults": true,
      "DevelopmentPortfolio": {
        "Enabled": true,
        "PortfolioName": "IFM Development Paper Portfolio v3",
        "ExecutionAccountReference": "IFM-EMULATOR-PAPER-V3",
        "InstrumentRoot": "ES",
        "Currency": "USD",
        "DevelopmentCapital": 1000000,
        "ProtectedReserve": 100000,
        "MaximumRiskPerTrade": 10000,
        "MaximumAggregateRisk": 100000,
        "MaximumMargin": 500000,
        "MaximumGrossNotional": 5000000,
        "MaximumContracts": 100,
        "MaximumOpenPositions": 100,
        "MaximumDrawdown": 200000
      }
    },
    "Databento": {
      "Dataset": "GLBX.MDP3",
      "DeploymentProfile": "Development",
      "DataSource": "DatabentoLive",
      "Synthetic": {
        "RecordCount": 10000,
        "RecordsPerSecond": 10,
        "StartSequence": 1
      }
    },
    "HistoricalAnalyticsWarmup": {
      "Enabled": true,
      "LookbackCalendarDays": 365,
      "MinimumValidDailySessions": 200,
      "MaximumCostUsd": 10.0,
      "MaximumBytes": 1073741824,
      "NormalizationVersion": "historical-daily-v1",
      "CalculationConfigurationVersion": "ema-bb-daily-v1"
    }
  },
  "ConnectionStrings": {
    "EventSourceActorDbConnection": "Host=localhost;Port=5432;Database=ifm_application_development",
    "ConfigurationDbConnection": "Host=localhost;Port=5432;Database=ifm_application_development",
    "MarketDataServiceDbConnection": "Host=localhost;Port=5432;Database=ifm_application_development",
    "SystemAdminDbConnection": "Host=localhost;Port=5432;Database=ifm_application_development",
    "SequenceIdDbConnection": "Host=localhost;Port=5432;Database=ifm_application_development",
    "PortfolioDbConnection": "Host=localhost;Port=5432;Database=ifm_application_development",
    "MarketDataDbConnection": "Host=localhost;Port=5432;Database=ifm_application_development",
    "ReferenceDbConnection": "Host=localhost;Port=5432;Database=ifm_application_development",
    "SecuritiesDbConnection": "Host=localhost;Port=5432;Database=ifm_application_development",
    "TradeDbConnection": "Host=localhost;Port=5432;Database=ifm_application_development",
    "TradePlanDbConnection": "Host=localhost;Port=5432;Database=ifm_application_development",
    "ScheduledTaskDbConnection": "Host=localhost;Port=5432;Database=ifm_application_development",
    "TradeTickQuoteDbConnection": "Contact Points=127.0.0.1;Default Keyspace=trade_tick_quote_test_db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "PostgresConnection": "Host=localhost;Port=5432;Database=ifm_application_development"
  },
  "MarketDataHost": {
    "Enabled": true,
    "NatsUrl": "nats://localhost:4222",
    "Scope": "development"
  }
}
