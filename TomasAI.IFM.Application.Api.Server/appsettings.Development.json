  "Kestrel": {
    "EndPoints": {
      "Http": {
        "Url": "http://localhost:22543"
      }
    }
  },
  "AppSettings": {
    "CommandServerBaseUri": "http://localhost:22543",
    "QueryServerBaseUri": "http://localhost:22543",
    "TelemetryServerBaseUri": "http://localhost:22543/Log/LogEvents",
    "PredictiveModelServerBaseUri": "http://localhost:22543",
    "RedisUri": "localhost:6379",
    "IntrinsicTimeStrategyWorkflow": {
      "MarketConditionAssessmentProfileId": "ES.Standard",
      "ProvisionDevelopmentMarketConditionAssessmentDefaults": true,
      "DevelopmentPortfolio": {
        "Enabled": true,
        "PortfolioName": "IFM Development Paper Portfolio",
        "ExecutionAccountReference": "IFM-EMULATOR-PAPER",
        "InstrumentRoot": "ES",
        "Currency": "USD",
        "DevelopmentCapital": 1000000,
        "ProtectedReserve": 100000,
        "MaximumRiskPerTrade": 10000,
        "MaximumAggregateRisk": 100000,
        "MaximumMargin": 500000,
        "MaximumGrossNotional": 5000000,
        "MaximumContracts": 100,
        "MaximumOpenPositions": 100,
        "MaximumDrawdown": 200000
      }
    },
    "Databento": {
      "Dataset": "GLBX.MDP3",
      "DeploymentProfile": "Development",
      "DataSource": "DatabentoLive",
      "Synthetic": {
        "RecordCount": 10000,
        "RecordsPerSecond": 10,
        "StartSequence": 1
      }
    },
    "HistoricalAnalyticsWarmup": {
      "Enabled": true,
      "LookbackCalendarDays": 365,
      "MinimumValidDailySessions": 200,
      "MaximumCostUsd": 10.0,
      "MaximumBytes": 1073741824,
      "NormalizationVersion": "historical-daily-v1",
      "CalculationConfigurationVersion": "ema-bb-daily-v1"
