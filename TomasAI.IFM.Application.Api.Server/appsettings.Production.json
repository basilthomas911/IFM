{
  "Kestrel": {
    "EndPoints": {
      "Http": {
        "Url": "http://localhost:4096"
      }
    }
  },
  "AppSettings": {
    "CommandServerBaseUri": "http://localhost:4096",
    "QueryServerBaseUri": "http://localhost:4096",
    "TelemetryServerBaseUri": "http://localhost:4096/Log/LogEvents",
    "PredictiveModelServerBaseUri": "http://localhost:4096",
    "RedisUri": "localhost:6379"
  },
  "ConnectionStrings": {
    "EventSourceActorDbConnection": "Host=localhost;Port=5432;Database=event-source-db",
    "LogDbConnection": "Host=localhost;Port=5432;Database=log-db",
    "SequenceIdDbConnection": "Host=localhost;Port=5432;Database=sequence-id-db",
    "TradeDbConnection": "Contact Points=localhost;Port=9042;Default Keyspace=trade_db",
    "FundDbConnection": "Contact Points=localhost;Port=9042;Default Keyspace=fund_db",
    "ReferenceDbConnection": "Contact Points=localhost;Port=9042;Default Keyspace=reference_db",
    "OptionPricerDbConnection": "Contact Points=localhost;Port=9042;Default Keyspace=option_pricer_db",
    "MarketDataDbConnection": "Contact Points=localhost;Port=9042;Default Keyspace=market_data_db",
    "SecuritiesDbConnection": "Contact Points=localhost;Port=9042;Default Keyspace=securities_db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "Telemetry": {
    "Metrics": {
      "Enabled": true,
      "ServiceName": "TomasAI.IFM.Application.Api.Server",
      "OtlpEndpoint": "http://localhost:4317",
      "OtlpProtocol": "grpc"
    }
  },
  "ActorRuntime": {
    "Admission": {
      "Mode": "ObserveOnly",
      "MailboxImplementation": "Channel",
      "GlobalMessageLimit": 0,
      "GlobalByteLimit": 0,
      "MaximumPayloadBytes": 0,
      "DefaultActorTypeMessageLimit": 0,
      "DefaultActorTypeByteLimit": 0,
      "DefaultMailboxMessageLimit": 8192,
      "RetainedIdleMailboxesPerActor": 1024,
      "JetStreamNakDelayMilliseconds": 250,
      "OverloadErrorCode": -429
    }
  },
  "Nats": {
    "Consumer": {
      "DispatcherCount": 4,
      "DispatcherCapacity": 4096,
      "SubscriptionCapacity": 0,
      "UseOwnedCommandPayloads": true,
      "UseOwnedQueryPayloads": true,
      "FireAndForgetTraffic": {
        "Command": "RequestReplyOnly",
        "Query": "RequestReplyOnly",
        "Event": "DurableLiveCopy",
        "Notify": "Optional",
        "UI": "Optional"
      }
    },
    "JetStreamConsumer": {
      "DispatcherCount": 4,
      "DispatcherCapacity": 4096,
      "MaxAckPending": 0,
      "MaxMessages": 0,
      "ThresholdMessages": 0,
      "UseOwnedEventPayloads": true
    }
  },
  "AllowedHosts": "*"
}
