<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DatabentoNativeImplementation Condition="'$(DatabentoNativeImplementation)' == ''">Cpp</DatabentoNativeImplementation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TomasAI.IFM.Framework.MarketData.DataBento\TomasAI.IFM.Framework.MarketData.DataBento.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <Target Name="BuildDatabentoSyntheticNative"
          BeforeTargets="Build"
          Condition="'$(OS)' == 'Windows_NT' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <DatabentoNativeLiveArgument Condition="'$(DatabentoEnableLive)' == 'true'">-EnableLive</DatabentoNativeLiveArgument>
      <DatabentoNativeRoot Condition="'$(DatabentoNativeImplementation)' == 'Rust'">$(MSBuildThisFileDirectory)..\native.rust\DatabentoFeed.Rust</DatabentoNativeRoot>
      <DatabentoNativeRoot Condition="'$(DatabentoNativeRoot)' == ''">$(MSBuildThisFileDirectory)..\native\DatabentoFeed.Native</DatabentoNativeRoot>
      <DatabentoNativeBuildKind Condition="'$(DatabentoEnableLive)' == 'true'">live-build</DatabentoNativeBuildKind>
      <DatabentoNativeBuildKind Condition="'$(DatabentoNativeBuildKind)' == ''">build</DatabentoNativeBuildKind>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(DatabentoNativeRoot)\build-native.ps1&quot; -Configuration $(Configuration) $(DatabentoNativeLiveArgument)" />
    <ItemGroup>
      <DatabentoNativeRuntimeDll Include="$(DatabentoNativeRoot)\out\$(DatabentoNativeBuildKind)\$(Configuration)\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(DatabentoNativeRuntimeDll)" DestinationFolder="$(OutDir)runtimes\win-x64\native" />
  </Target>

</Project>
