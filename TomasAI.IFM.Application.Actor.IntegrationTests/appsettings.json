{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "EventProjectorReliability": {
    "BoundedRecoveryEnabled": true,
    "FencedExecutionEnabled": true,
    "TransactionalOutboxEnabled": true,
    "BacklogMetricsPollingEnabled": true,
    "RecoveryBatchSize": 256,
    "RecoveryStreamConcurrency": 8,
    "MaximumReplayAttempts": 3,
    "InitialReplayDelay": "00:00:30",
    "ClaimLeaseDuration": "00:02:00",
    "OutboxBatchSize": 256,
    "MaximumOutboxAttempts": 20,
    "OutboxPollingInterval": "00:00:00.250",
    "OutboxDispatchLeaseDuration": "00:02:00",
    "MetricsPollingInterval": "00:00:05",
    "NonDurableQueueCapacity": 8192
  },
  "AllowedHosts": "*"
}
