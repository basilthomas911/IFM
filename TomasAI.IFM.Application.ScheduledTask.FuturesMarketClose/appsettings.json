{
  "Nats": {
    "Url": "nats://localhost:4222"
  },
  "JetStreamEndOfDayPurge": {
    "DrainTimeoutSeconds": 120,
    "DrainPollMilliseconds": 500,
    "EventStreamConsumerName": "EventConsumer",
    "StreamNamePatterns": [
      "^EventStream$",
      "^IFM_[A-Z][A-Za-z0-9]*Projector_(PROCESS|REPLAY)$"
    ]
  },
  "DatabaseBackup": {
    "EnvironmentIdentity": "local-workstation",
    "Destination": "online-vault",
    "Mode": "Automatic",
    "ProtectionSets": [ "core-postgresql", "read-model-scylla" ]
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File", "Serilog.Sinks.Console" ],
    "MinimumLevel": "Debug",
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "DiagnosticTrace" },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\TomasAI\\IFMAppDir\\ScheduledTasks\\Logs\\FuturesMarketClose_.log",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 4194304,
          "retainedFileCountLimit": 5,
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "IFM-ScheduledTask-FuturesMarketClose"
    }
  }
}
