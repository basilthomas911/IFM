<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NU1900</NoWarn>
    <OptionPricerRustRoot>$(MSBuildThisFileDirectory)..\native.rust\OptionPricer.Rust</OptionPricerRustRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TomasAI.IFM.Domain.OptionPricer\TomasAI.IFM.Domain.OptionPricer.csproj" />
    <ProjectReference Include="..\TomasAI.IFM.Domain.OptionPricer.Shared\TomasAI.IFM.Domain.OptionPricer.Shared.csproj" />
    <ProjectReference Include="..\TomasAI.IFM.Framework.OptionPricer\TomasAI.IFM.Framework.OptionPricer.csproj" />
  </ItemGroup>

  <Target Name="BuildAndCopyRustOptionPricer" BeforeTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(OptionPricerRustRoot)\build-native.ps1&quot; -Configuration $(Configuration)" />
    <MakeDir Directories="$(OutDir)runtimes\win-x64\native" />
    <Copy SourceFiles="$(OptionPricerRustRoot)\out\build\$(Configuration)\ifm_option_pricer_native.dll"
          DestinationFolder="$(OutDir)runtimes\win-x64\native" />
  </Target>
</Project>
