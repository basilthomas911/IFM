{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "IFM Rust UI: Build",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/UI/Rust/Build-RustUi.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "IFM Rust UI: Run Strategy Details",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/UI/Rust/Build-RustUi.ps1",
        "-Run"
      ],
      "problemMatcher": []
    },
    {
      "label": "IFM Rust UI: Run Live (Development)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/Start-IFMRustDevelopment.ps1"
      ],
      "dependsOn": [
        "IFM: Prepare API + Rust UI Debug"
      ],
      "dependsOrder": "sequence",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "IFM Rust UI: Prepare Live (Development)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "IFM: Wait for Development API",
        "IFM Rust UI: Build"
      ],
      "problemMatcher": []
    },
    {
      "label": "IFM Rust UI: Test",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/UI/Rust/Test-RustUi.ps1",
        "-Desktop",
        "-Visual"
      ],
      "problemMatcher": []
    },
    {
      "label": "IFM: Build API Server (Debug)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Build/Invoke-DotNet.ps1",
        "build",
        "${workspaceFolder}/TomasAI.IFM.Application.Api.Server/TomasAI.IFM.Application.Api.Server.csproj",
        "--configuration",
        "Debug",
        "--nologo"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "IFM: Build UI.Net (Debug)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Build/Invoke-DotNet.ps1",
        "build",
        "${workspaceFolder}/TomasAI.IFM.UI.Net/TomasAI.IFM.UI.Net.csproj",
        "--configuration",
        "Debug",
        "--nologo"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "IFM: Build Server Manager (Debug)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Build/Invoke-DotNet.ps1",
        "build",
        "${workspaceFolder}/TomasAI.IFM.Application.ServerManager/TomasAI.IFM.Application.ServerManager.csproj",
        "--configuration",
        "Debug",
        "--nologo"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "IFM: Build API + UI + Server Manager (Debug)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "IFM: Build API Server (Debug)",
        "IFM: Build UI.Net (Debug)",
        "IFM: Build Server Manager (Debug)",
        "IFM: Build Scheduler Host (Debug)"
      ],
      "problemMatcher": []
    },
    {
      "label": "IFM: Prepare API Server Debug",
      "dependsOrder": "sequence",
      "dependsOn": [
        "IFM: Stop API + UI (Development)",
        "IFM: Build API Server (Debug)"
      ],
      "problemMatcher": []
    },
    {
      "label": "IFM: Prepare API + UI Debug",
      "dependsOrder": "sequence",
      "dependsOn": [
        "IFM: Stop API + UI (Development)",
        "IFM: Build API + UI + Server Manager (Debug)"
      ],
      "problemMatcher": []
    },
    {
      "label": "IFM: Wait for Development API",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/Wait-IFMDevelopmentApi.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "IFM: Prepare UI.Net (Development)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "IFM: Build UI.Net (Debug)",
        "IFM: Wait for Development API"
      ],
      "problemMatcher": []
    },
    {
      "label": "IFM: Stop API + UI (Development)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/Stop-IFMDevelopment.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "IFM: Build Scheduler Host (Debug)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Build/Invoke-DotNet.ps1",
        "publish",
        "${workspaceFolder}/TomasAI.IFM.Application.ServerManager.SchedulerHost/TomasAI.IFM.Application.ServerManager.SchedulerHost.csproj",
        "/maxcpucount:1",
        "--configuration",
        "Debug",
        "--no-self-contained",
        "--output",
        "${workspaceFolder}/.artifacts/scheduled-tasks/development/Host",
        "--nologo"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "IFM: Prepare API + Rust UI Debug",
      "dependsOrder": "sequence",
      "dependsOn": [
        "IFM: Stop API + UI (Development)",
        "IFM: Build API Server (Debug)",
        "IFM Rust UI: Build",
        "IFM: Build Server Manager (Debug)",
        "IFM: Build Scheduler Host (Debug)"
      ],
      "problemMatcher": []
    }
  ]
}
