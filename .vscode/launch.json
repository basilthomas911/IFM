{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "IFM Rust UI: Live (Development; wait for API)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/.artifacts/rust-ui/app/ifm-ui-rust.exe",
      "cwd": "${workspaceFolder}/.artifacts/rust-ui/app",
      "preLaunchTask": "IFM Rust UI: Prepare Live (Development)",
      "environment": [
        {
          "name": "IFM_RUST_UI_MODE",
          "value": "live"
        },
        {
          "name": "DOTNET_ENVIRONMENT",
          "value": "Development"
        }
      ],
      "symbolSearchPath": "${workspaceFolder}/.artifacts/rust-ui/app;${workspaceFolder}/TomasAI.IFM.UI.Rust/target/debug",
      "presentation": {
        "group": "IFM Development",
        "order": 3,
        "hidden": true
      }
    },
    {
      "name": "IFM Rust UI: Native Strategy Details",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/.artifacts/rust-ui/app/ifm-ui-rust.exe",
      "cwd": "${workspaceFolder}/.artifacts/rust-ui/app",
      "preLaunchTask": "IFM Rust UI: Build",
      "symbolSearchPath": "${workspaceFolder}/.artifacts/rust-ui/app;${workspaceFolder}/TomasAI.IFM.UI.Rust/target/debug",
      "presentation": {
        "hidden": true
      }
    },
    {
      "name": "IFM Rust UI: Attach .NET bridge",
      "justMyCode": false,
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}",
      "presentation": {
        "hidden": true
      }
    },
    {
      "name": "IFM: API Server (Development)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "IFM: Prepare API Server Debug",
      "postDebugTask": "IFM: Stop API + UI (Development)",
      "program": "${workspaceFolder}/TomasAI.IFM.Application.Api.Server/bin/Debug/net10.0/TomasAI.IFM.Application.Api.Server.dll",
      "cwd": "${workspaceFolder}/TomasAI.IFM.Application.Api.Server",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "justMyCode": true,
      "env": {
        "DOTNET_ENVIRONMENT": "Development",
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "presentation": {
        "hidden": true
      }
    },
    {
      "name": "IFM: UI.Net (Development; wait for API)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "IFM: Prepare UI.Net (Development)",
      "program": "${workspaceFolder}/TomasAI.IFM.UI.Net/bin/Debug/net10.0-windows10.0.17763.0/TomasAI.IFM.UI.Net.dll",
      "cwd": "${workspaceFolder}/TomasAI.IFM.UI.Net",
      "console": "internalConsole",
      "stopAtEntry": false,
      "justMyCode": true,
      "env": {
        "DOTNET_ENVIRONMENT": "Development",
        "IFM_UI_START_MAXIMIZED": "true"
      },
      "presentation": {
        "group": "IFM Development",
        "order": 2,
        "hidden": true
      }
    },
    {
      "name": "_IFM: API Server (compound)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/TomasAI.IFM.Application.Api.Server/bin/Debug/net10.0/TomasAI.IFM.Application.Api.Server.dll",
      "cwd": "${workspaceFolder}/TomasAI.IFM.Application.Api.Server",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "justMyCode": true,
      "env": {
        "DOTNET_ENVIRONMENT": "Development",
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "presentation": {
        "hidden": true
      },
      "postDebugTask": "IFM: Stop API + UI (Development)"
    },
    {
      "name": "_IFM: UI.Net (compound)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "IFM: Wait for Development API",
      "program": "${workspaceFolder}/TomasAI.IFM.UI.Net/bin/Debug/net10.0-windows10.0.17763.0/TomasAI.IFM.UI.Net.dll",
      "cwd": "${workspaceFolder}/TomasAI.IFM.UI.Net",
      "console": "internalConsole",
      "stopAtEntry": false,
      "justMyCode": true,
      "env": {
        "DOTNET_ENVIRONMENT": "Development",
        "IFM_UI_START_MAXIMIZED": "true"
      },
      "presentation": {
        "hidden": true
      }
    },
    {
      "name": "_IFM: Server Manager (compound)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/TomasAI.IFM.Application.ServerManager/bin/Debug/net10.0-windows7.0/IFMServerManager.dll",
      "cwd": "${workspaceFolder}/TomasAI.IFM.Application.ServerManager/bin/Debug/net10.0-windows7.0",
      "console": "internalConsole",
      "stopAtEntry": false,
      "justMyCode": true,
      "env": {
        "DOTNET_ENVIRONMENT": "Development",
        "IFM_REPOSITORY_ROOT": "${workspaceFolder}"
      },
      "presentation": {
        "hidden": true
      },
      "postDebugTask": "IFM: Stop API + UI (Development)"
    },
    {
      "name": "_IFM: Server Manager + Rust (compound)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/TomasAI.IFM.Application.ServerManager/bin/Debug/net10.0-windows7.0/IFMServerManager.dll",
      "cwd": "${workspaceFolder}/TomasAI.IFM.Application.ServerManager/bin/Debug/net10.0-windows7.0",
      "console": "internalConsole",
      "stopAtEntry": false,
      "justMyCode": true,
      "env": {
        "DOTNET_ENVIRONMENT": "Development",
        "IFM_REPOSITORY_ROOT": "${workspaceFolder}",
        "IFM_DEVELOPMENT_UI": "Rust"
      },
      "presentation": {
        "hidden": true
      },
      "postDebugTask": "IFM: Stop API + UI (Development)"
    },
    {
      "name": "_IFM: Server Manager + eGui Rust (compound)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/TomasAI.IFM.Application.ServerManager/bin/Debug/net10.0-windows7.0/IFMServerManager.dll",
      "cwd": "${workspaceFolder}/TomasAI.IFM.Application.ServerManager/bin/Debug/net10.0-windows7.0",
      "console": "internalConsole",
      "stopAtEntry": false,
      "justMyCode": true,
      "env": {
        "DOTNET_ENVIRONMENT": "Development",
        "IFM_REPOSITORY_ROOT": "${workspaceFolder}",
        "IFM_DEVELOPMENT_UI": "eGui",
        "IFM_UI_CONFIG_PATH": "${workspaceFolder}/TomasAI.IFM.UI.Net/appsettings.Development.json"
      },
      "presentation": {
        "hidden": true
      },
      "postDebugTask": "IFM: Stop API + UI (Development)"
    }
  ],
  "compounds": [
    {
      "name": "IFM: API + UI (Development)",
      "configurations": [
        "_IFM: Server Manager (compound)"
      ],
      "preLaunchTask": "IFM: Prepare API + UI Debug",
      "stopAll": true,
      "presentation": {
        "group": "IFM Development",
        "order": 1
      }
    },
    {
      "name": "IFM: API + Rust UI (Development)",
      "configurations": [
        "_IFM: Server Manager + Rust (compound)"
      ],
      "preLaunchTask": "IFM: Prepare API + Rust UI Debug",
      "stopAll": true,
      "presentation": {
        "group": "IFM Development",
        "order": 2
      }
    },
    {
      "name": "IFM: API + eGui Rust UI (Development)",
      "configurations": [
        "_IFM: Server Manager + eGui Rust (compound)"
      ],
      "preLaunchTask": "IFM: Prepare API + eGui Rust UI Debug",
      "stopAll": true,
      "presentation": {
        "group": "IFM Development",
        "order": 3
      }
    }
  ]
}
